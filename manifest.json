{
   "manifest_version": 2,
   "name": "gwin's-window-resizer",
   "short_name": "FWR",
   "version": "1.1.2",
   "description": "簡単にブラウザウィンドウのサイズと位置を変更できます",
   "icons": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "96": "assets/icons/icon-96.png"
   },
   "browser_action": {
      "default_icon": {
         "16": "assets/icons/icon-16.png",
         "32": "assets/icons/icon-32.png",
         "48": "assets/icons/icon-48.png",
         "96": "assets/icons/icon-96.png"
      },
      "default_popup": "views/popup.html"
   },
   "background": {
      "scripts": [
         "scripts/logger.js",
         "scripts/store.js",
         "scripts/background.js"
      ],
      "persistent": false
   },
   "permissions": [
      "storage",
      "tabs",
      "contextMenus",
      "bookmarks",
      "history"
   ],
   "sidebar_action": {
      "default_title": "履歴を別ウィンドウで開く",
      "default_panel": "views/history-sidebar.html",
      "open_at_install": false,
      "default_icon": {
         "16": "assets/icons/icon-16.png",
         "32": "assets/icons/icon-32.png"
      }
   },
   "options_ui": {
      "page": "views/settings.html",
      "open_in_tab": true
   },
   "browser_specific_settings": {
      "gecko": {
         "id": "gwins-window-resizer@gwin7ok.com",
         "strict_min_version": "140.0",
         "data_collection_permissions": {
            "required": [
               "none"
            ]
         }
      }
   }
}