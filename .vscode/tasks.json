{
    "version": "2.0.0",
    "tasks": [
        {
            // ローカル確認用の未署名XPIを生成 (dist/gwins-window-resizer.xpi)
            "label": "Publish: (Release win-x64)",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "./tools/build-xpi.ps1"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "showReuseMessage": false
            }
        },
        {
            // 更新履歴の更新（manifest.json の version 更新 + CHANGELOG の [Unreleased] を版に切り出し）
            "label": "Update Changelog",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "./tools/bump-version.ps1"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "showReuseMessage": false
            }
        },
        {
            // リリース生成（Release vX.Y.Z をコミット → push → タグ発行 → Actions が署名・公開）
            "label": "release-tag-and-push-short",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "./tools/release-tag.ps1",
                "-CommitRelease"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "showReuseMessage": false
            }
        },
        {
            // リリース内容の事前確認（何も実行しない）
            "label": "release-tag: dry run",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "./tools/release-tag.ps1",
                "-CommitRelease",
                "-DryRun"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "showReuseMessage": false
            }
        }
    ]
}
